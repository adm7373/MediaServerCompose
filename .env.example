# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored so your secrets/paths are never committed.
#
# Find PUID/PGID by running: id -u (for PUID) and id -g (for PGID)
# Find your timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

# ---- Common settings (applied across most services) ----
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Media/download paths (absolute paths on the host) ----
MOVIES_PATH=/path/to/media/movies
TV_PATH=/path/to/media/tv
DOWNLOADS_PATH=/path/to/downloads

# ---- Mullvad VPN configuration (used by Gluetun) ----
# See the MULLVAD VPN CONFIGURATION section in docker-compose.yml for how to
# obtain these values.
WIREGUARD_PRIVATE_KEY=your_private_key_here
WIREGUARD_ADDRESSES=your_wireguard_address_here
SERVER_CITIES=Ashburn VA

# ---- Plex ----
# Optional: Plex claim token to automatically link server to your Plex account on boot.
# Generate a token at: https://www.plex.tv/claim (tokens expire in 4 minutes)
# Leave blank or commented if you prefer manual web UI sign-in.
PLEX_CLAIM=

# ---- Unpackerr / Arr API Keys ----
# Pre-set static API keys so Sonarr, Radarr, and Unpackerr talk immediately on first boot!
# Any 32-character hexadecimal string works (or keep the defaults below).
SONARR_API_KEY=84197c977f0b3e3a33286a3b1366ca11
RADARR_API_KEY=b9dbe221732492462011fcd943157dca

# ---- Homepage host validation (DNS-rebinding protection) ----
# Homepage rejects requests whose Host header isn't in this comma-separated
# allow-list. Each entry must match the "host:port" you type in the browser
# (e.g. nas.local:3002). Add every hostname/IP you use to reach the dashboard.
# No spaces after commas. If unset/blank, only localhost:3000 is allowed.
HOMEPAGE_ALLOWED_HOSTS=nas.local:3002
